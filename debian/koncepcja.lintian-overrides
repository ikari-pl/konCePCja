# The Bitstream Vera fonts ship under their own licence (licenses/Bitstream
# Vera License.txt); the embedding bits in the files are the upstream's.
koncepcja: truetype-font-prohibits-installable-embedding
# Not a Debian upload; there is no ITP bug to close.
koncepcja: initial-upload-closes-no-bugs
# A deliberate private copy (see debian/rules): Ubuntu's libjpeg is
# libjpeg.so.8 (package libjpeg8), Debian's is libjpeg.so.62 (libjpeg62-turbo),
# and no package provides both, so a .deb that depends on either installs on
# one of the two only. It lives in /usr/lib/koncepcja next to the private SDL3,
# reached through the binary's rpath, and nothing else can load it.
koncepcja: embedded-library libjpeg *
