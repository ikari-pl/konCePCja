{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (win64, MSYS2)",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\build-win64.bat",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run koncepcja.exe",
      "type": "shell",
      "command": "${workspaceFolder}\\koncepcja.exe",
      "options": {
        "env": { "PATH": "${env:MSYS2_ROOT}\\mingw64\\bin;C:\\msys64\\mingw64\\bin;${env:PATH}" }
      },
      "dependsOn": "Build (win64, MSYS2)",
      "problemMatcher": []
    }
  ]
}
